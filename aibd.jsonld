   "@id": "https://petervartanian.xyz/aibd/records/AIBD-0151.html#benefit",
   "@type": "CreativeWork",
   "identifier": "AIBD-0151",
   "name": "STAR finds two motile sperm, letting a couple have a girl after 19 years",
   "description": "Columbia University's STAR system found seven sperm, two of them motile, in 2.5 million images of a “sperm-free” sample. A couple who had tried for 19 years then had a girl.",
   "url": "https://petervartanian.xyz/aibd/records/AIBD-0151.html",
   "sameAs": "https://w3id.org/aibd/AIBD-0151",
   "temporalCoverage": "2025-03",
   "dateModified": "2026-11-03",
   "isPartOf": {
    "@id": "https://petervartanian.xyz/aibd/#dataset"
   },
   "about": {
    "@type": "SoftwareApplication",
    "name": "STAR (Sperm Tracking and Recovery): a semen sample flows through a single-use microfluidic chip while a high-speed camera (about 300 frames per second, over 8 million images an hour) images it; an AI object-detection model flags sperm among cellular debris in real time and a microfluidic gate or robotic step diverts each flagged sperm into a droplet for immediate injection or freezing",
    "creator": {
     "@type": "Organization",
     "name": "Columbia University, Columbia University Irving Medical Center (team led by Zev Williams and Hemant Suryawanshi)"
    }
   },
   "spatialCoverage": [
